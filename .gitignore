dist/
build/
.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Docker
.dockerignore

# Uploads (temporary files)
uploads/
tmp/
