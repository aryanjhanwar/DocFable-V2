# ─── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env and fill in your values

# OpenRouter API Key (recommended — free models available)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenRouter model (optional)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Google Gemini API Key (fallback if OpenRouter is not set)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (optional)
# Other options: gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash-lite

# Server port (optional, defaults to 5000)
PORT=5000

# Frontend URL for CORS (optional, defaults to localhost:5173)
FRONTEND_URL=http://localhost:5173

# Python environment
ENVIRONMENT=development
